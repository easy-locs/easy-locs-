name: CI

on: push

jobs:
  build:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: '22'

      - run: echo "CI START"

      - run: npm install --legacy-peer-deps

      - run: echo "INSTALL OK"

      - run: npm run build

      - run: echo "BUILD OK"