entrypoint = "index.js"
modules = ["nodejs-22"]
hidden = [".config", "package-lock.json"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix", "package.json", "package-lock.json"]

[nix]
channel = "stable-24_11"

[deployment]
run = ["node", "index.js"]
deploymentTarget = "static"
ignorePorts = false
build = ["bash", "-c", "cd easy-locs-ea1eb0ed && npm install && npm run build"]
publicDir = "easy-locs-ea1eb0ed/dist"

[agent]
expertMode = true

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "cd easy-locs-ea1eb0ed && npm run dev"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

