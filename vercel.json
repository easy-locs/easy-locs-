{
  "buildCommand": "bash scripts/vercel-build.sh",
  "outputDirectory": "dist",
  "framework": null,
  "rewrites": [
    { "source": "/share/:type/:slug", "destination": "/api/share?type=:type&slug=:slug" },
    { "source": "/((?!assets|pwa-|manifest|registerSW|robots|sitemap|og-|~|api/).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets|pwa-|manifest|registerSW|robots|sitemap|og-|~).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/index.html",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/firebase-messaging-sw.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/registerSW.js",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
