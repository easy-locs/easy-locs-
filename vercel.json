{
  "buildCommand": "cd easy-locs-ea1eb0ed && npm install && npm run build",
  "outputDirectory": "easy-locs-ea1eb0ed/dist",
  "framework": null,
  "rewrites": [
    { "source": "/(.*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/((?!assets|pwa-|manifest|registerSW|robots|sitemap|og-|~).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-store, no-cache, must-revalidate, max-age=0" }]
    },
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    }
  ]
}
