# E2E environment variables — copy to .env.e2e.local and fill in real values.
# .env.e2e.local is gitignored; NEVER commit real credentials.
#
# Usage:
#   cp .env.e2e.local.example .env.e2e.local
#   # fill in real values, then:
#   export $(grep -v '^#' .env.e2e.local | xargs)
#   npm run test:e2e

# ── Server ────────────────────────────────────────────────────────────────────
# Base URL of the environment under test.
E2E_BASE_URL=http://localhost:5173

# ── Playwright parallelism ────────────────────────────────────────────────────
# Number of parallel workers. Increase for faster runs on powerful machines.
E2E_WORKERS=6

# Set to 1 on CI to enable cross-browser projects (Chromium + Firefox + WebKit).
# Leave at 0 for local dev (Chromium only — faster iteration).
E2E_SHARDED=0

# ── Root-suite: simple authenticated tests (tests/e2e/) ───────────────────────
# Used by easy-locs-ea1eb0ed/e2e/fixtures/base.fixture.ts authenticatedPage.
# When absent, those tests skip automatically (safe in fork PRs).
E2E_TEST_EMAIL=qa+email@easy-locs.test
E2E_TEST_PASSWORD=

# ── Multi-profile suite (tests/fixtures/profiles.ts) ─────────────────────────
# Email-confirmed user
QA_EMAIL_USER=qa+email@easy-locs.test
QA_EMAIL_PASSWORD=

# Phone-OTP user — requires dev-only OTP bypass token
QA_PHONE_NUMBER=+10000000000
QA_OTP_BYPASS_TOKEN=

# Super-admin account (required by e2e/admin-control.spec.ts)
QA_ADMIN_EMAIL=qa+admin@easy-locs.test
QA_ADMIN_PASSWORD=

# Also used by e2e/admin-control.spec.ts (alternative env-var names)
E2E_SUPER_ADMIN_EMAIL=qa+admin@easy-locs.test
E2E_SUPER_ADMIN_PASSWORD=

# Empty-data user
QA_EMPTY_EMAIL=qa+empty@easy-locs.test
QA_EMPTY_PASSWORD=

# Heavy-data user
QA_HEAVY_EMAIL=qa+heavy@easy-locs.test
QA_HEAVY_PASSWORD=

# ── Load testing (k6) ─────────────────────────────────────────────────────────
# Falls back to E2E_BASE_URL if not set.
LOAD_BASE_URL=http://localhost:5173
LOAD_PROFILE=local
